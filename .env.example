# Copy to .env (Prisma CLI and Next.js both read it) and fill in the values.

# --- Database (Neon Postgres, or the local docker-compose one) ---
# Local docker-compose:  postgresql://postgres:postgres@localhost:5432/postgres
# Neon: DATABASE_URL is the pooled connection string, DIRECT_URL the direct one (used by migrations).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# --- Neon Auth (Neon console -> your project -> Auth) ---
# Server-side Neon Auth URL, e.g. https://ep-xxx.neonauth.<region>.aws.neon.tech/<dbname>/auth
NEON_AUTH_BASE_URL=""
# At least 32 characters. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=""
